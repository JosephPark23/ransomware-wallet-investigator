{
  "name": "chainmark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.js\"",
    "smoke": "esbuild src/main.jsx --bundle --format=iife --loader:.css=empty --loader:.json=json --jsx=automatic --define:import.meta.env={} --outfile=.smoke/app.js --log-level=error && node tools/smoke-render.mjs",
    "verify": "npm run test && npm run smoke && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.9"
  }
}
